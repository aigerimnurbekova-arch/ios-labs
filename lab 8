              });
            },
          ),
          SwitchListTile(
            title: const Text('Автовоспроизведение'),
            subtitle: const Text('Автоматически запускать видео'),
            value: autoplay,
            onChanged: (value) {
              setState(() {
                autoplay = value;
              });
            },
          ),
          const Divider(),
          ListTile(
            leading: const Icon(Icons.card_membership),
            title: const Text('Подписка KinoPass'),
            subtitle: Text(
              widget.subscription.isActive
                  ? 'Активна • ${widget.subscription.daysLeft} дней осталось'
                  : 'Не активна',
            ),
            trailing: const Icon(Icons.arrow_forward_ios, size: 16),
            onTap: () {
              showSubscriptionSheet(context, widget.subscription);
            },
          ),
          const AboutListTile(
            icon: Icon(Icons.info_outline),
            applicationName: 'KinoPass',
            applicationVersion: '1.0.0',
            applicationLegalese: '© 2026 KinoPass',
          ),
        ],
      ),
    );
  }
}

