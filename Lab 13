// One GPS reading that we attach to a diary entry.
class DiaryGeoFix {
  final double latitude;
  final double longitude;
  final double accuracy;
  final double altitude;
  final DateTime timestamp;

  const DiaryGeoFix({
    required this.latitude,
    required this.longitude,
    required this.accuracy,
    required this.altitude,
    required this.timestamp,
  });

  factory DiaryGeoFix.fromPosition(Position position) {
    return DiaryGeoFix(
      latitude: position.latitude,
      longitude: position.longitude,
      accuracy: position.accuracy,
      altitude: position.altitude,
      timestamp: position.timestamp,
    );
  }

  Map<String, dynamic> toJson() => {
    'latitude': latitude,
    'longitude': longitude,
    'accuracy': accuracy,
    'altitude': altitude,
    'timestamp': timestamp.millisecondsSinceEpoch,
  };

  factory DiaryGeoFix.fromJson(Map<String, dynamic> json) {
    return DiaryGeoFix(
      latitude: (json['latitude'] as num?)?.toDouble() ?? 0,
      longitude: (json['longitude'] as num?)?.toDouble() ?? 0,
      accuracy: (json['accuracy'] as num?)?.toDouble() ?? 0,
      altitude: (json['altitude'] as num?)?.toDouble() ?? 0,
      timestamp: DateTime.fromMillisecondsSinceEpoch(
        (json['timestamp'] as num?)?.toInt() ?? 0,
      ),
    );
  }
}

// One diary entry. On mobile [photo] is a file name inside
// <documents>/photos, on web it is a data: URL with the picture bytes.
class DiaryEntry {
  final String id;
  final String caption;
  final String? photo;
  final DiaryGeoFix? location;
  final DateTime createdAt;

  const DiaryEntry({
    required this.id,
    required this.caption,
    required this.photo,
    required this.location,
    required this.createdAt,
  });

  Map<String, dynamic> toJson() => {
    'id': id,
    'caption': caption,
    'photo': photo,
    'location': location?.toJson(),
    'createdAt': createdAt.millisecondsSinceEpoch,
  };

  factory DiaryEntry.fromJson(Map<String, dynamic> json) {
    final location = json['location'];
    return DiaryEntry(
      id:
          json['id']?.toString() ??
          DateTime.now().microsecondsSinceEpoch.toString(),
      caption: json['caption']?.toString() ?? '',
      photo: json['photo']?.toString(),
      location: location is Map
          ? DiaryGeoFix.fromJson(Map<String, dynamic>.from(location))
          : null,
      createdAt: DateTime.fromMillisecondsSinceEpoch(
        (json['createdAt'] as num?)?.toInt() ?? 0,
      ),
    );
  }
}

// '43.2389° N, 76.8897° E'
String diaryFormatCoordinates(double latitude, double longitude) {
  final latText =
      '${latitude.abs().toStringAsFixed(4)}° ${latitude >= 0 ? 'N' : 'S'}';
  final lonText =
      '${longitude.abs().toStringAsFixed(4)}° ${longitude >= 0 ? 'E' : 'W'}';
  return '$latText, $lonText';
}

// '28.11.2026 14:05' (same day.month.year style as the notes vault)
String diaryFormatDateTime(DateTime value) {
  final time = value.toLocal(); // GPS timestamps come in UTC
  String two(int value) => value.toString().padLeft(2, '0');
  return '${two(time.day)}.${two(time.month)}.${time.year} '
      '${two(time.hour)}:${two(time.minute)}';
}

// Saving and loading entries + photo files.
class DiaryStorage {
  static const String entriesKey = 'photo_diary_entries';

  static Future<List<DiaryEntry>> loadEntries() async {
    final prefs = await SharedPreferences.getInstance();
    final saved = prefs.getString(entriesKey);
    if (saved == null || saved.isEmpty) return [];
    try {
      final decoded = jsonDecode(saved) as List<dynamic>;
      return decoded
          .map(
            (item) =>
                DiaryEntry.fromJson(Map<String, dynamic>.from(item as Map)),
          )
          .toList();
    } catch (error) {
      debugPrint('Could not read diary entries: $error');
      return [];
    }
  }

  static Future<bool> saveEntries(List<DiaryEntry> entries) async {
    try {
      final prefs = await SharedPreferences.getInstance();
      final jsonString = jsonEncode(
        entries.map((entry) => entry.toJson()).toList(),
      );
      return await prefs.setString(entriesKey, jsonString);
    } catch (error) {
      // On web localStorage has a small limit (about 5 MB).
      debugPrint('Could not save diary entries: $error');
      return false;
    }
  }

  // Full path of the photos folder. We only save the file name in the
  // entry, because the app container path changes on iOS after updates.
  static Future<String?> photosFolder() async {
    if (kIsWeb) return null;
    try {
      final documents = await getApplicationDocumentsDirectory();
      return '${documents.path}/photos';
    } catch (error) {
      debugPrint('Documents folder is not available: $error');
      return null;
    }
  }

  static Future<String> copyPhoto(XFile photo, String id) async {
    final folder = await photosFolder();
    if (folder == null) throw Exception('Documents folder is not available');
    await Directory(folder).create(recursive: true);
    final fileName = '$id.jpg';
    await File(photo.path).copy('$folder/$fileName');
    return fileName;
  }

  static Future<void> deletePhoto(DiaryEntry entry) async {
    final photo = entry.photo;
    if (kIsWeb || photo == null || photo.startsWith('data:')) return;
    try {
      final folder = await photosFolder();
      if (folder == null) return;
      final file = File('$folder/$photo');
      if (await file.exists()) await file.delete();
    } catch (error) {
      debugPrint('Could not delete photo: $error');
    }
  }
}

// Shows a saved photo (file name / data URL) or a camera placeholder.
class DiaryPhotoView extends StatelessWidget {
  final String? photo;
  final String? photosFolder;
  final double iconSize;

  const DiaryPhotoView({
    super.key,
    required this.photo,
    required this.photosFolder,
    this.iconSize = 32,
  });

  Widget _placeholder(BuildContext context) {
    return Container(
      color: Theme.of(context).colorScheme.surfaceContainerHighest,
      alignment: Alignment.center,
      child: Icon(
        Icons.photo_camera_outlined,
        size: iconSize,
        color: Theme.of(context).colorScheme.onSurfaceVariant,
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final value = photo;
    if (value == null || value.isEmpty) return _placeholder(context);

    if (value.startsWith('data:')) {
      try {
        return Image.memory(
          UriData.parse(value).contentAsBytes(),
          fit: BoxFit.cover,
          errorBuilder: (context, error, stackTrace) => _placeholder(context),
        );
      } catch (_) {
        return _placeholder(context);
      }
    }

    if (kIsWeb || photosFolder == null) return _placeholder(context);

    return Image.file(
      File('$photosFolder/$value'),
      fit: BoxFit.cover,
      errorBuilder: (context, error, stackTrace) => _placeholder(context),
    );
  }
}

