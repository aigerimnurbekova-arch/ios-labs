// ==================== LAB 12: BLOC SHOP - AUTH CUBIT ====================

class AuthCubit extends Cubit<AuthState> {
  static const String demoEmail = 'student@narxoz.kz';
  static const String demoPassword = '123456';

  AuthCubit() : super(const AuthInitial());

  Future<void> login(String email, String password) async {
    // Ignore new taps while the "server" is still answering
    if (state is AuthLoading) return;

    // Reset an old error first: Equatable skips an identical state,
    // so the same error twice in a row would not show a SnackBar again
    if (state is AuthError) emit(const AuthInitial());

    final cleanEmail = email.trim().toLowerCase();

    if (cleanEmail.isEmpty && password.isEmpty) {
      emit(const AuthError('Please enter email and password'));
      return;
    }
    if (cleanEmail.isEmpty) {
      emit(const AuthError('Please enter your email'));
      return;
    }
    if (password.isEmpty) {
      emit(const AuthError('Please enter your password'));
      return;
    }

    emit(const AuthLoading());

    // Simulated server request
    await Future.delayed(const Duration(seconds: 2));

    if (isClosed) return;

    if (cleanEmail == demoEmail && password == demoPassword) {
      emit(
        AuthSuccess(username: cleanEmail.split('@').first, email: cleanEmail),
      );
    } else {
      emit(const AuthError('Invalid email or password'));
    }
  }

  void logout() {
    emit(const AuthInitial());
  }
}

