class DiaryNewEntryScreen extends StatefulWidget {
  const DiaryNewEntryScreen({super.key});

  @override
  State<DiaryNewEntryScreen> createState() => _DiaryNewEntryScreenState();
}

class _DiaryNewEntryScreenState extends State<DiaryNewEntryScreen> {
  final ImagePicker _picker = ImagePicker();
  final TextEditingController _captionController = TextEditingController();

  XFile? _photo;
  String? _webPhotoData; // data: URL, only used on web
  DiaryGeoFix? _location;
  bool _isLocating = false;
  bool _isSaving = false;

  @override
  void dispose() {
    _captionController.dispose();
    super.dispose();
  }

  void _showMessage(String text, {SnackBarAction? action}) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).hideCurrentSnackBar();
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(text),
        behavior: SnackBarBehavior.floating,
        action: action,
      ),
    );
  }

  Future<void> _showSettingsDialog({
    required String title,
    required String message,
    required Future<bool> Function() openSettings,
  }) async {
    if (!mounted) return;
    await showDialog<void>(
      context: context,
      builder: (context) => AlertDialog(
        title: Text(title),
        content: Text(message),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Cancel'),
          ),
          FilledButton(
            onPressed: () {
              Navigator.pop(context);
              // openSettings can throw (for example on web), never crash.
              Future.sync(openSettings).catchError((Object error) {
                debugPrint('Could not open settings: $error');
                return false;
              });
            },
            child: const Text('Open Settings'),
          ),
        ],
      ),
    );
  }

  // ----- Task 1: permissions for camera / photos -----

  Future<bool> _checkPhotoPermission(ImageSource source) async {
    // permission_handler does not work on web, the browser asks by itself.
    if (kIsWeb) return true;

    try {
      if (source == ImageSource.camera) {
        final status = await Permission.camera.request();
        if (status.isGranted || status.isLimited) return true;
        if (status.isPermanentlyDenied) {
          await _showSettingsDialog(
            title: 'Camera access is off',
            message: 'Camera permission was denied permanently. Please allow it in Settings to take photos.',
            openSettings: openAppSettings,
          );
        } else {
          _showMessage(
            'Camera permission denied',
            action: SnackBarAction(
              label: 'Try again',
              onPressed: () => _pickPhoto(ImageSource.camera),
            ),
          );
        }
        return false;
      }

      // Gallery: the system Photo Picker (Android) / PHPicker (iOS) works
      // without this permission, so we only explain and still open it.
      final status = await Permission.photos.request();
      if (!status.isGranted && !status.isLimited) {
        _showMessage(
          'No full photo access. The system picker will still let you choose a photo.',
        );
      }
      return true;
    } catch (error) {
      debugPrint('Permission check failed: $error');
      return true;
    }
  }

  // ----- Task 2: capture -----

  Future<void> _pickPhoto(ImageSource source) async {
    // 'Try again' in a SnackBar can be tapped after this screen is closed.
    if (!mounted) return;
    final allowed = await _checkPhotoPermission(source);
    if (!allowed) return;

    XFile? picked;
    try {
      picked = await _picker.pickImage(
        source: source,
        imageQuality: 80,
        maxWidth: 1080,
      );
    } catch (error) {
      debugPrint('Image picker error: $error');
      _showMessage(
        source == ImageSource.camera
            ? 'Could not open the camera on this device'
            : 'Could not open the gallery',
      );
      return;
    }
    if (picked == null) return; // user closed the picker

    String? webData;
    if (kIsWeb) {
      final bytes = await picked.readAsBytes();
      webData =
          'data:${picked.mimeType ?? 'image/jpeg'};base64,${base64Encode(bytes)}';
    }

    if (!mounted) return;
    setState(() {
      _photo = picked;
      _webPhotoData = webData;
    });

    // After a new camera photo we tag it with the current location.
    if (source == ImageSource.camera) {
      await _fetchLocation();
    }
  }

  void _showPhotoSourceSheet() {
    showModalBottomSheet<void>(
      context: context,
      showDragHandle: true,
      builder: (context) => SafeArea(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            ListTile(
              leading: const Icon(Icons.photo_camera_outlined),
              title: const Text('Take a photo'),
              onTap: () {
                Navigator.pop(context);
                _pickPhoto(ImageSource.camera);
              },
            ),
            ListTile(
              leading: const Icon(Icons.photo_library_outlined),
              title: const Text('Choose from gallery'),
              onTap: () {
                Navigator.pop(context);
                _pickPhoto(ImageSource.gallery);
              },
            ),
            if (_photo != null)
              ListTile(
                leading: const Icon(
                  Icons.delete_outline,
                  color: Colors.redAccent,
                ),
                title: const Text('Remove photo'),
                onTap: () {
                  Navigator.pop(context);
                  setState(() {
                    _photo = null;
                    _webPhotoData = null;
                  });
                },
              ),
          ],
        ),
      ),
    );
  }

  // ----- Task 3: GPS -----

  Future<void> _fetchLocation() async {
    if (!mounted || _isLocating) return;
    setState(() => _isLocating = true);

    try {
      final serviceEnabled = await Geolocator.isLocationServiceEnabled();
      if (!serviceEnabled) {
        await _showSettingsDialog(
          title: 'Location is turned off',
          message: 'Turn on location services (GPS) to tag your photo. You can also save the entry without coordinates.',
          openSettings: Geolocator.openLocationSettings,
        );
        return;
      }

      var permission = await Geolocator.checkPermission();
      if (permission == LocationPermission.denied) {
        permission = await Geolocator.requestPermission();
      }

      if (permission == LocationPermission.denied) {
        _showMessage(
          'Location permission denied. The entry can be saved without coordinates.',
          action: SnackBarAction(label: 'Try again', onPressed: _fetchLocation),
        );
        return;
      }

      if (permission == LocationPermission.deniedForever) {
        // A browser has no app settings page: geolocator_web throws there.
        if (kIsWeb) {
          _showMessage(
            'Location is blocked for this site. Allow it in the browser address bar. The entry can be saved without coordinates.',
          );
          return;
        }
        await _showSettingsDialog(
          title: 'Location access is blocked',
          message: 'Location permission was denied permanently. Allow it in Settings to add coordinates.',
          openSettings: Geolocator.openAppSettings,
        );
        return;
      }

      Position? position;
      try {
        position = await Geolocator.getCurrentPosition(
          locationSettings: const LocationSettings(
            accuracy: LocationAccuracy.high,
            timeLimit: Duration(seconds: 20),
          ),
        );
      } on TimeoutException {
        // No fresh fix in 20 seconds: use the last known one on mobile.
        if (!kIsWeb) position = await Geolocator.getLastKnownPosition();
      }

      if (position == null) {
        _showMessage(
          'Could not get your location in time',
          action: SnackBarAction(label: 'Try again', onPressed: _fetchLocation),
        );
        return;
      }

      final fix = DiaryGeoFix.fromPosition(position);
      if (mounted) setState(() => _location = fix);
    } on LocationServiceDisabledException {
      _showMessage('Location services are turned off');
    } catch (error) {
      debugPrint('Location error: $error');
      _showMessage(
        'Could not get your location',
        action: SnackBarAction(label: 'Try again', onPressed: _fetchLocation),
      );
    } finally {
      if (mounted) setState(() => _isLocating = false);
    }
  }

  // ----- Task 4: save entry -----

  Future<void> _saveEntry() async {
    final caption = _captionController.text.trim();
    final photo = _photo;
    if (photo == null && caption.isEmpty) {
      _showMessage('Add a photo or write a caption first');
      return;
    }

    setState(() => _isSaving = true);
    final id = DateTime.now().microsecondsSinceEpoch.toString();
    String? savedPhoto;

    if (photo != null) {
      if (kIsWeb) {
        savedPhoto = _webPhotoData;
      } else {
        try {
          savedPhoto = await DiaryStorage.copyPhoto(photo, id);
        } catch (error) {
          debugPrint('Could not copy photo: $error');
          if (mounted) setState(() => _isSaving = false);
          _showMessage('Could not save the photo');
          return;
        }
      }
    }

    final entry = DiaryEntry(
      id: id,
      caption: caption,
      photo: savedPhoto,
      location: _location,
      createdAt: DateTime.now(),
    );

    if (!mounted) return;
    Navigator.pop(context, entry);
  }

  Widget _buildPreview() {
    final photo = _photo;
    Widget content;

    if (photo == null) {
      content = Container(
        color: Theme.of(context).colorScheme.surfaceContainerHighest,
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(
              Icons.photo_camera_outlined,
              size: 64,
              color: Theme.of(context).colorScheme.onSurfaceVariant,
            ),
            const SizedBox(height: 8),
            const Text('Tap to add a photo'),
          ],
        ),
      );
    } else if (kIsWeb) {
      content = Image.network(photo.path, fit: BoxFit.cover);
    } else {
      content = Image.file(File(photo.path), fit: BoxFit.cover);
    }

    return GestureDetector(
      onTap: _showPhotoSourceSheet,
      child: ClipRRect(
        borderRadius: BorderRadius.circular(20),
        child: AspectRatio(aspectRatio: 4 / 3, child: content),
      ),
    );
  }

  Widget _infoRow(String label, String value) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 3),
      child: Row(
        children: [
          SizedBox(
            width: 90,
            child: Text(
              label,
              style: const TextStyle(fontWeight: FontWeight.w600),
            ),
          ),
          Expanded(child: Text(value)),
        ],
      ),
    );
  }

  Widget _buildLocationCard() {
    final location = _location;
    Widget content;

    if (_isLocating) {
      content = const Row(
        children: [
          SizedBox(
            width: 22,
            height: 22,
            child: CircularProgressIndicator(strokeWidth: 2.5),
          ),
          SizedBox(width: 12),
          Text('Getting your location...'),
        ],
      );
    } else if (location == null) {
      content = const Text('No coordinates yet. Tap "Fetch GPS".');
    } else {
      content = Column(
        children: [
          _infoRow('Latitude', location.latitude.toStringAsFixed(6)),
          _infoRow('Longitude', location.longitude.toStringAsFixed(6)),
          _infoRow('Accuracy', '± ${location.accuracy.toStringAsFixed(1)} m'),
          _infoRow('Altitude', '${location.altitude.toStringAsFixed(1)} m'),
          _infoRow('Timestamp', diaryFormatDateTime(location.timestamp)),
        ],
      );
    }

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text('Location', style: Theme.of(context).textTheme.titleMedium),
            const SizedBox(height: 10),
            content,
            const SizedBox(height: 12),
            SizedBox(
              width: double.infinity,
              child: OutlinedButton.icon(
                onPressed: _isLocating ? null : _fetchLocation,
                icon: const Icon(Icons.my_location),
                label: const Text('Fetch GPS'),
              ),
            ),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('New Diary Entry')),
      body: SafeArea(
        child: ListView(
          padding: const EdgeInsets.all(16),
          children: [
            _buildPreview(),
            const SizedBox(height: 12),
            Row(
              children: [
                Expanded(
                  child: FilledButton.icon(
                    onPressed: () => _pickPhoto(ImageSource.camera),
                    icon: const Icon(Icons.photo_camera),
                    label: const Text('Camera'),
                  ),
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: FilledButton.tonalIcon(
                    onPressed: () => _pickPhoto(ImageSource.gallery),
                    icon: const Icon(Icons.photo_library),
                    label: const Text('Gallery'),
                  ),
                ),
              ],
            ),
            const SizedBox(height: 12),
            _buildLocationCard(),
            const SizedBox(height: 12),
            TextField(
              controller: _captionController,
              maxLines: 3,
              minLines: 1,
              textCapitalization: TextCapitalization.sentences,
              decoration: const InputDecoration(
                labelText: 'Caption',
                hintText: 'What is happening in this photo?',
                border: OutlineInputBorder(),
              ),
            ),
            const SizedBox(height: 16),
            SizedBox(
              width: double.infinity,
              child: ElevatedButton.icon(
                onPressed: _isSaving ? null : _saveEntry,
                icon: _isSaving
                    ? const SizedBox(
                        width: 18,
                        height: 18,
                        child: CircularProgressIndicator(strokeWidth: 2),
                      )
                    : const Icon(Icons.save_outlined),
                label: const Text('Save Entry'),
              ),
            ),
          ],
        ),
      ),
    );
  }
