class ShopCartItem extends Equatable {
  final ShopProduct product;
  final int quantity;

  const ShopCartItem({required this.product, required this.quantity});

  int get lineTotal => product.price * quantity;

  @override
  List<Object?> get props => [product, quantity];
}

abstract class ShopCartEvent extends Equatable {
  const ShopCartEvent();

  @override
  List<Object?> get props => [];
}

class AddProductEvent extends ShopCartEvent {
  final ShopProduct product;

  const AddProductEvent(this.product);

  @override
  List<Object?> get props => [product];
}

class RemoveProductEvent extends ShopCartEvent {
  final ShopProduct product;

  const RemoveProductEvent(this.product);

  @override
  List<Object?> get props => [product];
}

class ClearCartEvent extends ShopCartEvent {
  const ClearCartEvent();
}

class ShopCartState extends Equatable {
  final List<ShopCartItem> items;
  final int totalPrice;
  final int count;

  const ShopCartState({
    this.items = const [],
    this.totalPrice = 0,
    this.count = 0,
  });

  factory ShopCartState.fromItems(List<ShopCartItem> items) {
    int total = 0;
    int count = 0;
    for (final item in items) {
      total += item.lineTotal;
      count += item.quantity;
    }
    return ShopCartState(
      items: List.unmodifiable(items),
      totalPrice: total,
      count: count,
    );
  }

  @override
  List<Object?> get props => [items, totalPrice, count];
}

class ShopCartBloc extends Bloc<ShopCartEvent, ShopCartState> {
  ShopCartBloc() : super(const ShopCartState()) {
    on<AddProductEvent>(_onAdd);
    on<RemoveProductEvent>(_onRemove);
    on<ClearCartEvent>(_onClear);
  }

  void _onAdd(AddProductEvent event, Emitter<ShopCartState> emit) {
    final items = List<ShopCartItem>.from(state.items);
    final index = items.indexWhere(
      (item) => item.product.id == event.product.id,
    );

    if (index == -1) {
      items.add(ShopCartItem(product: event.product, quantity: 1));
    } else {
      final old = items[index];
      items[index] = ShopCartItem(
        product: old.product,
        quantity: old.quantity + 1,
      );
    }
    emit(ShopCartState.fromItems(items));
  }

  void _onRemove(RemoveProductEvent event, Emitter<ShopCartState> emit) {
    final items = state.items
        .where((item) => item.product.id != event.product.id)
        .toList();
    emit(ShopCartState.fromItems(items));
  }

  void _onClear(ClearCartEvent event, Emitter<ShopCartState> emit) {
    emit(const ShopCartState());
  }
}

