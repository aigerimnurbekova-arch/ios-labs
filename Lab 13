// ==================== SUBSCRIPTION ====================

class Subscription extends ChangeNotifier {
  DateTime? _activeUntil;

  bool get isActive =>
      _activeUntil != null && _activeUntil!.isAfter(DateTime.now());

  int get daysLeft {
    if (!isActive) return 0;
    return _activeUntil!.difference(DateTime.now()).inDays + 1;
  }

  void activate() {
    _activeUntil = DateTime.now().add(const Duration(days: 14));
    notifyListeners();
  }
}

// ==================== CART PROVIDER ====================

class CartProvider extends ChangeNotifier {
  final List<Movie> _items = [];
  final List<Product> _products = [];
  List<Movie> get items => List.unmodifiable(_items);
  List<Product> get productItems => List.unmodifiable(_products);

  void addProductToCart(Product product) {
    if (_products.any((item) => item.id == product.id)) return;
    _products.add(product);
    notifyListeners();
  }

  int get itemCount => _items.length;

  int get totalPrice => _items.fold(0, (total, movie) => total + movie.price);

  bool contains(Movie movie) {
    return _items.any((item) => item.id == movie.id);
  }

  void addToCart(Movie movie) {
    if (contains(movie)) return;
    _items.add(movie);
    notifyListeners();
  }

  void removeFromCart(Movie movie) {
    _items.removeWhere((item) => item.id == movie.id);
    notifyListeners();
  }

  void clearCart() {
    _items.clear();
    notifyListeners();
  }
}

