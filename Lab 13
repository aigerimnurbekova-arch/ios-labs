class _PhotoDiaryScreenState extends State<PhotoDiaryScreen> {
  List<DiaryEntry> _entries = [];
  String? _photosFolder;
  bool _isLoading = true;

  @override
  void initState() {
    super.initState();
    _loadEntries();
  }

  Future<void> _loadEntries() async {
    final entries = await DiaryStorage.loadEntries();
    if (!mounted) return;
    setState(() {
      _entries = entries;
      _isLoading = false;
    });

    // The photos folder is only needed for thumbnails, so the list
    // is shown first and the pictures appear when the path is ready.
    final folder = await DiaryStorage.photosFolder();
    if (!mounted || folder == null) return;
    setState(() => _photosFolder = folder);
  }

  Future<bool> _saveEntries() async {
    final saved = await DiaryStorage.saveEntries(_entries);
    if (!saved && mounted) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Could not save the diary. Storage may be full.'),
        ),
      );
    }
    return saved;
  }

  Future<void> _openNewEntry() async {
    final entry = await Navigator.push<DiaryEntry>(
      context,
      MaterialPageRoute(builder: (context) => const DiaryNewEntryScreen()),
    );
    if (entry == null || !mounted) return;
    setState(() => _entries.insert(0, entry));
    final saved = await _saveEntries();
    if (!saved || !mounted) return;
    ScaffoldMessenger.of(context)
        .showSnackBar(const SnackBar(content: Text('Entry saved')));
  }

  Future<void> _openDetails(DiaryEntry entry) async {
    final deleted = await Navigator.push<bool>(
      context,
      MaterialPageRoute(
        builder: (context) =>
            DiaryEntryDetailScreen(entry: entry, photosFolder: _photosFolder),
      ),
    );
    if (deleted != true || !mounted) return;
    setState(() => _entries.removeWhere((item) => item.id == entry.id));
    await _saveEntries();
    await DiaryStorage.deletePhoto(entry);
    if (!mounted) return;
    ScaffoldMessenger.of(context)
        .showSnackBar(const SnackBar(content: Text('Entry deleted')));
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Photo Diary')),
