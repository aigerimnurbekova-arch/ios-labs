class NoteItem {
  final String id;
  final String title;
  final String dateText;
  final bool isCompleted;

  const NoteItem({
    required this.id,
    required this.title,
    required this.dateText,
    required this.isCompleted,
  });

  Map<String, dynamic> toJson() => {
    'id': id,
    'title': title,
    'dateText': dateText,
    'isCompleted': isCompleted,
  };

  factory NoteItem.fromJson(Map<String, dynamic> json) {
    return NoteItem(
      id:
          json['id']?.toString() ??
          DateTime.now().microsecondsSinceEpoch.toString(),
      title: json['title']?.toString() ?? 'Untitled note',
      dateText: json['dateText']?.toString() ?? '',
      isCompleted: json['isCompleted'] as bool? ?? false,
    );
  }

  NoteItem copyWith({bool? isCompleted}) => NoteItem(
    id: id,
    title: title,
    dateText: dateText,
    isCompleted: isCompleted ?? this.isCompleted,
  );
}

class NotesVaultScreen extends StatefulWidget {
  final bool isDarkMode;
  final ValueChanged<bool> onThemeChanged;

  const NotesVaultScreen({
    super.key,
    required this.isDarkMode,
    required this.onThemeChanged,
  });

  @override
  State<NotesVaultScreen> createState() => _NotesVaultScreenState();
}

class _NotesVaultScreenState extends State<NotesVaultScreen> {
  static const String _themeKey = 'app_theme_dark_mode';
  static const String _nameKey = 'user_display_name';
  static const String _notesKey = 'saved_notes_list';

  final TextEditingController _nameController = TextEditingController();
  final TextEditingController _noteController = TextEditingController();
  List<NoteItem> _notes = [];
  String _displayName = 'Guest User';
  bool _isLoading = true;
  late bool _darkMode = widget.isDarkMode;

  @override
  void initState() {
    super.initState();
    _loadSavedData();
  }

  Future<void> _loadSavedData() async {
    final prefs = await SharedPreferences.getInstance();
    final savedName = prefs.getString(_nameKey) ?? 'Guest User';
    final savedNotes = prefs.getString(_notesKey);
    List<NoteItem> loadedNotes = [];

    if (savedNotes != null && savedNotes.isNotEmpty) {
      try {
        final decoded = jsonDecode(savedNotes) as List<dynamic>;
        loadedNotes = decoded
            .map(
              (item) =>
                  NoteItem.fromJson(Map<String, dynamic>.from(item as Map)),
            )
            .toList();
      } catch (error) {
        debugPrint('Could not read saved notes: $error');
      }
    }

    if (!mounted) return;
    setState(() {
      _displayName = savedName;
      _nameController.text = savedName == 'Guest User' ? '' : savedName;
      _notes = loadedNotes;
      _isLoading = false;
    });
  }

  Future<void> _saveName() async {
    final name = _nameController.text.trim();
    if (name.isEmpty) {
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(const SnackBar(content: Text('Please enter a username')));
      return;
    }
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(_nameKey, name);
    if (!mounted) return;
    setState(() => _displayName = name);
    ScaffoldMessenger.of(context)
        .showSnackBar(const SnackBar(content: Text('Username saved')));
  }

  Future<void> _saveNotes() async {
    final prefs = await SharedPreferences.getInstance();
    final jsonString = jsonEncode(_notes.map((note) => note.toJson()).toList());
    await prefs.setString(_notesKey, jsonString);
  }

  Future<void> _addNote() async {
    final title = _noteController.text.trim();
    if (title.isEmpty) return;
    final now = DateTime.now();
    final dateText =
        '${now.day.toString().padLeft(2, '0')}.${now.month.toString().padLeft(2, '0')}.${now.year}';
    setState(() {
      _notes.insert(
        0,
        NoteItem(
          id: now.microsecondsSinceEpoch.toString(),
          title: title,
          dateText: dateText,
          isCompleted: false,
        ),
      );
      _noteController.clear();
    });
    await _saveNotes();
  }

  Future<void> _toggleNote(NoteItem note, bool value) async {
    setState(() {
      final index = _notes.indexWhere((item) => item.id == note.id);
      if (index != -1) _notes[index] = note.copyWith(isCompleted: value);
    });
    await _saveNotes();
  }

  Future<void> _deleteNote(NoteItem note) async {
    setState(() => _notes.removeWhere((item) => item.id == note.id));
    await _saveNotes();
  }

  Future<void> _changeTheme(bool value) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setBool(_themeKey, value);
    widget.onThemeChanged(value);
    if (mounted) setState(() => _darkMode = value);
  }

  @override
  void dispose() {
    _nameController.dispose();
    _noteController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Offline Notes & Settings Vault')),
      body: _isLoading
          ? const Center(child: CircularProgressIndicator())
          : SafeArea(
              child: ListView(
                padding: const EdgeInsets.all(16),
                children: [
                  Card(
                    child: Padding(
                      padding: const EdgeInsets.all(16),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            'Hello, $_displayName!',
                            style: Theme.of(context).textTheme.headlineSmall,
                          ),
                          const SizedBox(height: 12),
                          TextField(
                            controller: _nameController,
                            decoration: const InputDecoration(
                              labelText: 'Username',
                              hintText: 'Enter your name',
                              border: OutlineInputBorder(),
                            ),
                          ),
                          const SizedBox(height: 10),
                          SizedBox(
                            width: double.infinity,
                            child: ElevatedButton.icon(
                              onPressed: _saveName,
                              icon: const Icon(Icons.save_outlined),
                              label: const Text('Save username'),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                  const SizedBox(height: 12),
                  Card(
                    child: SwitchListTile(
                      secondary: Icon(
                        _darkMode ? Icons.dark_mode : Icons.light_mode,
                      ),
                      title: const Text('Dark Mode'),
                      subtitle: const Text('Theme is saved on this device'),
                      value: _darkMode,
                      onChanged: _changeTheme,
                    ),
                  ),
                  const SizedBox(height: 20),
                  Text(
                    'My Notes',
                    style: Theme.of(context).textTheme.titleLarge,
                  ),
                  const SizedBox(height: 10),
                  Row(
                    children: [
                      Expanded(
                        child: TextField(
                          controller: _noteController,
                          textInputAction: TextInputAction.done,
                          onSubmitted: (_) => _addNote(),
                          decoration: const InputDecoration(
                            hintText: 'Write a new note...',
                            border: OutlineInputBorder(),
                          ),
                        ),
                      ),
                      const SizedBox(width: 8),
                      IconButton.filled(
                        onPressed: _addNote,
                        icon: const Icon(Icons.add),
                        tooltip: 'Add note',
                      ),
                    ],
                  ),
                  const SizedBox(height: 12),
                  if (_notes.isEmpty)
                    const Padding(
                      padding: EdgeInsets.symmetric(vertical: 30),
                      child: Center(
                        child: Text('No notes yet. Add your first note.'),
                      ),
                    )
                  else
                    ..._notes.map(
                      (note) => Card(
                        child: ListTile(
                          leading: Checkbox(
                            value: note.isCompleted,
                            onChanged: (value) =>
                                _toggleNote(note, value ?? false),
                          ),
                          title: Text(
                            note.title,
                            style: TextStyle(
                              decoration: note.isCompleted
                                  ? TextDecoration.lineThrough
                                  : null,
                              color: note.isCompleted
                                  ? Theme.of(context).disabledColor
                                  : null,
                            ),
                          ),
                          subtitle: Text(note.dateText),
                          trailing: IconButton(
                            tooltip: 'Delete note',
                            icon: const Icon(
                              Icons.delete_outline,
                              color: Colors.redAccent,
                            ),
                            onPressed: () => _deleteNote(note),
                          ),
                        ),
                      ),
                    ),
                  const SizedBox(height: 16),
                  Text(
                    'Notes are stored locally as one JSON string. They remain available after closing and reopening the app.',
                    style: Theme.of(context).textTheme.bodySmall,
                  ),
                ],
              ),
            ),
    );
  }
}

