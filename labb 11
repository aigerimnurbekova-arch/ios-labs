class HomeScreen extends StatefulWidget {
  final Subscription subscription;
  final bool isDarkMode;
  final ValueChanged<bool> onThemeChanged;
  const HomeScreen({
    super.key,
    required this.subscription,
    required this.isDarkMode,
    required this.onThemeChanged,
  });
  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  int selectedIndex = 0;
  bool isGridView = false;
  bool isSearching = false;

  final TextEditingController searchController = TextEditingController();
  final Set<String> favoriteTitles = {};

  List<Movie> movies = List.from(nowInCinema);

  List<Movie> get filteredMovies {
    if (searchController.text.isEmpty) return movies;

    return movies.where((movie) {
      return movie.title.toLowerCase().contains(
        searchController.text.toLowerCase(),
      );
    }).toList();
  }

  List<Movie> get favoriteMovies {
    return movies
        .where((movie) => favoriteTitles.contains(movie.title))
        .toList();
  }

  void toggleFavorite(Movie movie) {
    setState(() {
      if (favoriteTitles.contains(movie.title)) {
        favoriteTitles.remove(movie.title);
      } else {
        favoriteTitles.add(movie.title);
      }
    });
  }

  Future<void> refreshMovies() async {
    await Future.delayed(const Duration(milliseconds: 1500));

    if (!mounted) return;

    final newMovie = Movie(
      id: DateTime.now().microsecondsSinceEpoch.toString(),
      title: 'Новая премьера',
      genre: 'Новинка',
      year: 2026,
      durationMinutes: 110,
      rating: 8.2,
      ageLimit: '12+',
      price: 2000,
      imageUrl:
          'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=800',
      description: 'Новая премьера в каталоге KinoPass.',
    );

    setState(() {
      movies.insert(0, newMovie);
    });
  }

  void deleteMovie(Movie movie) {
    final index = movies.indexWhere((item) => item.id == movie.id);

    if (index == -1) return;

    setState(() {
      movies.removeAt(index);
    });

    ScaffoldMessenger.of(context).hideCurrentSnackBar();

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('${movie.title} удалён'),
        action: SnackBarAction(
          label: 'UNDO',
          onPressed: () {
            setState(() {
              movies.insert(index.clamp(0, movies.length), movie);
            });
          },
        ),
      ),
    );
  }

  void resetCatalog() {
    setState(() {
      movies = List.from(nowInCinema);
      searchController.clear();
    });
  }

  Widget deleteBackground() {
    return Container(
      alignment: Alignment.centerRight,
      padding: const EdgeInsets.only(right: 25),
      color: Colors.red,
      child: const Icon(Icons.delete, color: Colors.white, size: 30),
    );
  }

  // ==================== LIST VIEW ====================

  Widget buildListView() {
    final visibleMovies = filteredMovies;

    return ListView.separated(
      physics: const AlwaysScrollableScrollPhysics(),
      padding: const EdgeInsets.all(12),
      itemCount: visibleMovies.length,
      separatorBuilder: (context, index) => const SizedBox(height: 8),
      itemBuilder: (context, index) {
        final movie = visibleMovies[index];

        return Dismissible(
          key: ValueKey(movie.id),
          direction: DismissDirection.endToStart,
          background: deleteBackground(),
          onDismissed: (direction) {
            deleteMovie(movie);
          },
          child: MovieListItem(
            movie: movie,
            isFavorite: favoriteTitles.contains(movie.title),
            onFavorite: () => toggleFavorite(movie),
            isInCart: context.watch<CartProvider>().contains(movie),
            onCart: () {
              final cart = context.read<CartProvider>();
              if (cart.contains(movie)) {
                cart.removeFromCart(movie);
              } else {
                cart.addToCart(movie);
              }
            },
            onTap: () => openMovie(movie),
          ),
        );
      },
    );
  }

  // ==================== GRID VIEW ====================

  Widget buildGridView() {
    final visibleMovies = filteredMovies;

    return GridView.builder(
      physics: const AlwaysScrollableScrollPhysics(),
      padding: const EdgeInsets.all(12),
      itemCount: visibleMovies.length,
      gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
        crossAxisCount: 2,
        childAspectRatio: 0.72,
        crossAxisSpacing: 12,
        mainAxisSpacing: 12,
      ),
      itemBuilder: (context, index) {
        final movie = visibleMovies[index];

        return Dismissible(
          key: ValueKey(movie.id),
          direction: DismissDirection.endToStart,
          background: deleteBackground(),
          onDismissed: (direction) {
            deleteMovie(movie);
          },
          child: MovieGridItem(
            movie: movie,
            isFavorite: favoriteTitles.contains(movie.title),
            onFavorite: () => toggleFavorite(movie),
            isInCart: context.watch<CartProvider>().contains(movie),
            onCart: () {
              final cart = context.read<CartProvider>();
              if (cart.contains(movie)) {
                cart.removeFromCart(movie);
              } else {
                cart.addToCart(movie);
              }
            },
            onTap: () => openMovie(movie),
          ),
        );
      },
    );
  }

  // ==================== EMPTY STATE ====================

  Widget buildEmptyState() {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          const Icon(
            Icons.movie_creation_outlined,
            size: 65,
            color: Colors.grey,
          ),
          const SizedBox(height: 15),
          const Text('Catalog is Empty', style: TextStyle(fontSize: 20)),
          const SizedBox(height: 15),
          ElevatedButton(
            onPressed: resetCatalog,
            child: const Text('Reset Catalog'),
          ),
        ],
      ),
    );
  }

  // ==================== FEED ====================

  Widget buildFeed() {
    if (movies.isEmpty) {
      return buildEmptyState();
    }

    return Column(
      children: [
        SubscriptionBanner(subscription: widget.subscription),
        Padding(
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
          child: Row(
            children: [
              const Expanded(
                child: Text(
                  'Сейчас в кино',
                  style: TextStyle(fontSize: 21, fontWeight: FontWeight.bold),
                ),
              ),
              IconButton(
                tooltip: 'Список',
                onPressed: () {
                  setState(() {
                    isGridView = false;
                  });
                },
                icon: Icon(
                  Icons.view_list,
                  color: isGridView ? Colors.grey : Colors.deepOrange,
                ),
              ),
              IconButton(
                tooltip: 'Сетка',
                onPressed: () {
                  setState(() {
                    isGridView = true;
                  });
                },
                icon: Icon(
                  Icons.grid_view,
                  color: isGridView ? Colors.deepOrange : Colors.grey,
                ),
              ),
            ],
          ),
        ),
        Expanded(
          child: RefreshIndicator(
            onRefresh: refreshMovies,
            child: isGridView ? buildGridView() : buildListView(),
          ),
        ),
      ],
    );
  }

  // ==================== FAVORITES ====================

  Widget buildFavorites() {
    if (favoriteMovies.isEmpty) {
      return const Center(
        child: Text(
          'Пока нет избранных фильмов',
          style: TextStyle(fontSize: 17),
        ),
      );
    }

    return ListView.separated(
      padding: const EdgeInsets.all(12),
      itemCount: favoriteMovies.length,
      separatorBuilder: (context, index) => const SizedBox(height: 8),
      itemBuilder: (context, index) {
        final movie = favoriteMovies[index];

        return MovieListItem(
          movie: movie,
          isFavorite: true,
          onFavorite: () => toggleFavorite(movie),
          isInCart: context.watch<CartProvider>().contains(movie),
          onCart: () {
            final cart = context.read<CartProvider>();
            if (cart.contains(movie)) {
              cart.removeFromCart(movie);
            } else {
              cart.addToCart(movie);
            }
          },
          onTap: () => openMovie(movie),
        );
      },
    );
  }

  // ==================== PROFILE ====================

  Widget buildProfile() {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          const CircleAvatar(
            radius: 48,
            backgroundColor: Colors.deepOrange,
            child: Icon(Icons.person, size: 55, color: Colors.white),
          ),
          const SizedBox(height: 15),
          const Text(
            'Пользователь KinoPass',
            style: TextStyle(fontSize: 21, fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 25),
          ListTile(
            leading: const Icon(Icons.favorite),
            title: const Text('Избранные фильмы'),
            trailing: const Icon(Icons.arrow_forward_ios, size: 16),
            onTap: () {
              setState(() {
