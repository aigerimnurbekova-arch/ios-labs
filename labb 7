// Экран подробной информации о фильме
class MovieDetailScreen extends StatelessWidget {
  final Movie movie;
  final Subscription subscription;
  final bool isFavorite;
  final VoidCallback onFavoriteChanged;

  const MovieDetailScreen({
    super.key,
    required this.movie,
    required this.subscription,
    required this.isFavorite,
    required this.onFavoriteChanged,
  });

  // Трейлер доступен только для первого фильма
  Future<void> openTrailer(BuildContext context) async {
    final url = Uri.parse(
      'https://www.youtube.com/results?search_query='
      'Dune+Part+Three+official+trailer',
    );

    try {
      final opened = await launchUrl(
        url,
        mode: LaunchMode.externalApplication,
      );

      if (!opened && context.mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('Не удалось открыть YouTube'),
          ),
        );
      }
    } catch (_) {
      if (context.mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('Проверьте подключение к интернету'),
          ),
        );
      }
    }
  }

  void watchMovie(BuildContext context) {
    if (subscription.isActive) {
      Navigator.push(
        context,
        MaterialPageRoute(
          builder: (_) => PlayerScreen(movie: movie),
        ),
      );
    } else {
      showSubscriptionSheet(context, subscription);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(movie.title),
        actions: [
          IconButton(
            onPressed: onFavoriteChanged,
            icon: Icon(
              isFavorite ? Icons.favorite : Icons.favorite_border,
              color: isFavorite ? Colors.redAccent : null,
            ),
          ),
        ],
      ),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          MoviePoster(
            movie: movie,
            width: double.infinity,
            height: 330,
          ),
          const SizedBox(height: 20),
          Text(
            movie.title,
            style: const TextStyle(
              fontSize: 24,
              fontWeight: FontWeight.bold,
            ),
          ),
          const SizedBox(height: 8),
          Text(
            '${movie.genre} · ${movie.year} · '
            '${movie.duration} · ${movie.ageLimit}',
          ),
          const SizedBox(height: 8),
          RatingRow(rating: movie.rating),
          const SizedBox(height: 16),
          Text(
            movie.description,
            style: const TextStyle(height: 1.5),
          ),

          // Кнопка трейлера только у первого фильма
          if (movie.title == 'Дюна: Часть третья') ...[
            const SizedBox(height: 20),
            FilledButton.icon(
              onPressed: () => openTrailer(context),
              icon: const Icon(Icons.play_circle_outline),
              label: const Text('Смотреть трейлер'),
            ),
          ],

          const SizedBox(height: 12),
          OutlinedButton.icon(
            onPressed: () => Navigator.pop(context),
            icon: const Icon(Icons.arrow_back),
            label: const Text('Вернуться к списку фильмов'),
          ),
          const SizedBox(height: 12),
          ListenableBuilder(
            listenable: subscription,
            builder: (_, __) => FilledButton.icon(
              onPressed: () => watchMovie(context),
              icon: Icon(
                subscription.isActive ? Icons.play_arrow : Icons.lock,
              ),
              label: Text(
                subscription.isActive
                    ? 'Смотреть'
                    : 'Смотреть по подписке за '
                        '${Subscription.priceTenge} ₸',
              ),
            ),
          ),
        ],
      ),
    );
  }
}

