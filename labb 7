// Главный экран с нижней навигацией
class HomeScreen extends StatefulWidget {
  final Subscription subscription;

  const HomeScreen({super.key, required this.subscription});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  int selectedIndex = 0;
  bool searchMode = false;
  String searchText = '';

  final Set<String> favoriteTitles = {};

  void toggleFavorite(Movie movie) {
    setState(() {
      if (favoriteTitles.contains(movie.title)) {
        favoriteTitles.remove(movie.title);
      } else {
        favoriteTitles.add(movie.title);
      }
    });
  }

  void openMovie(Movie movie) {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => MovieDetailScreen(
          movie: movie,
          subscription: widget.subscription,
          isFavorite: favoriteTitles.contains(movie.title),
          onFavoriteChanged: () => toggleFavorite(movie),
        ),
      ),
    ).then((_) {
      if (mounted) setState(() {});
    });
  }

  void openSettings() {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => SettingsScreen(
          subscription: widget.subscription,
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final pages = [
      buildFeed(),
      buildFavorites(),
      buildProfile(),
    ];

    return Scaffold(
      appBar: AppBar(
        title: searchMode
            ? TextField(
                autofocus: true,
                decoration: const InputDecoration(
                  hintText: 'Поиск фильмов...',
                  border: InputBorder.none,
                ),
                onChanged: (value) {
                  setState(() {
                    searchText = value;
                    selectedIndex = 0;
                  });
                },
              )
            : const Text('KinoPass'),
        actions: [
          // Кнопка поиска
          IconButton(
            tooltip: searchMode ? 'Закрыть поиск' : 'Поиск',
            icon: Icon(searchMode ? Icons.close : Icons.search),
            onPressed: () {
              setState(() {
                searchMode = !searchMode;
                searchText = '';

                if (searchMode) {
                  selectedIndex = 0;
                }
              });
            },
          ),

          // Кнопка настроек
          IconButton(
            tooltip: 'Настройки',
            icon: const Icon(Icons.settings_outlined),
            onPressed: openSettings,
          ),
        ],
      ),

      // IndexedStack сохраняет состояние вкладок
      body: IndexedStack(
        index: selectedIndex,
        children: pages,
      ),

      bottomNavigationBar: NavigationBar(
        selectedIndex: selectedIndex,
        onDestinationSelected: (index) {
          setState(() {
            selectedIndex = index;
          });
        },
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.movie_outlined),
            selectedIcon: Icon(Icons.movie),
            label: 'Feed',
          ),
          NavigationDestination(
            icon: Icon(Icons.favorite_border),
            selectedIcon: Icon(Icons.favorite),
            label: 'Favorites',
          ),
          NavigationDestination(
            icon: Icon(Icons.person_outline),
            selectedIcon: Icon(Icons.person),
            label: 'Profile',
          ),
        ],
      ),
    );
  }

  // Вкладка Feed
  Widget buildFeed() {
    final movies = nowInCinema.where((movie) {
      final query = searchText.toLowerCase();

      return movie.title.toLowerCase().contains(query) ||
          movie.genre.toLowerCase().contains(query);
    }).toList();

    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        ListenableBuilder(
          listenable: widget.subscription,
          builder: (_, __) => SubscriptionBanner(
            subscription: widget.subscription,
            onSubscribe: () {
              showSubscriptionSheet(context, widget.subscription);
            },
          ),
        ),
        const SizedBox(height: 20),
        const Text(
          'Сейчас в кино',
          style: TextStyle(
            fontSize: 20,
            fontWeight: FontWeight.bold,
          ),
        ),
        const SizedBox(height: 12),
        if (movies.isEmpty)
          const Padding(
            padding: EdgeInsets.all(24),
            child: Center(
              child: Text('Фильмы не найдены'),
            ),
          ),
        for (final movie in movies)
          MovieListItem(
            movie: movie,
            isFavorite: favoriteTitles.contains(movie.title),
            onFavorite: () => toggleFavorite(movie),
            onTap: () => openMovie(movie),
          ),
      ],
    );
  }

  // Вкладка Favorites
  Widget buildFavorites() {
    final movies = nowInCinema
        .where((movie) => favoriteTitles.contains(movie.title))
        .toList();

    if (movies.isEmpty) {
      return const Center(
        child: Padding(
          padding: EdgeInsets.all(24),
          child: Text(
            'Пока нет избранных фильмов.\n'
            'Добавьте фильм на вкладке Feed.',
            textAlign: TextAlign.center,
          ),
        ),
      );
    }

    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        const Text(
          'Избранные фильмы',
          style: TextStyle(
            fontSize: 20,
            fontWeight: FontWeight.bold,
          ),
        ),
        const SizedBox(height: 12),
        for (final movie in movies)
          MovieListItem(
            movie: movie,
            isFavorite: true,
            onFavorite: () => toggleFavorite(movie),
            onTap: () => openMovie(movie),
          ),
      ],
    );
  }

  // Вкладка Profile
  Widget buildProfile() {
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        const CircleAvatar(
          radius: 42,
          child: Icon(Icons.person, size: 48),
        ),
        const SizedBox(height: 12),
        const Center(
          child: Text(
            'Пользователь KinoPass',
            style: TextStyle(
              fontSize: 20,
              fontWeight: FontWeight.bold,
            ),
          ),
        ),
        const SizedBox(height: 24),
        Card(
          child: ListTile(
            leading: const Icon(Icons.favorite),
            title: const Text('Избранные фильмы'),
            subtitle: Text('Сохранено: ${favoriteTitles.length}'),
            trailing: const Icon(Icons.chevron_right),
            onTap: () {
              setState(() {
                selectedIndex = 1;
              });
            },
          ),
        ),
        Card(
          child: ListTile(
            leading: const Icon(Icons.settings),
            title: const Text('Настройки'),
            subtitle: const Text('Открыть настройки приложения'),
            trailing: const Icon(Icons.chevron_right),
            onTap: openSettings,
          ),
        ),
      ],
    );
  }
}

