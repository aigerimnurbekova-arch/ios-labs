// Модель фильма
class Movie {
  final String title;
  final String genre;
  final int year;
  final int durationMinutes;
  final double rating;
  final String ageLimit;
  final String description;
  final String imageUrl;

  const Movie({
    required this.title,
    required this.genre,
    required this.year,
    required this.durationMinutes,
    required this.rating,
    required this.ageLimit,
    required this.description,
    required this.imageUrl,
  });

  String get duration {
    final hours = durationMinutes ~/ 60;
    final minutes = durationMinutes % 60;
    return '$hours ч $minutes мин';
  }
}

// Подписка
class Subscription extends ChangeNotifier {
  static const int priceTenge = 3;
  static const int periodDays = 14;

  DateTime? _activeUntil;

  bool get isActive =>
      _activeUntil != null && DateTime.now().isBefore(_activeUntil!);

  int get daysLeft {
    if (!isActive) return 0;
    return _activeUntil!.difference(DateTime.now()).inDays + 1;
  }

  void activate() {
    final start = isActive ? _activeUntil! : DateTime.now();
    _activeUntil = start.add(const Duration(days: periodDays));
    notifyListeners();
  }
}

