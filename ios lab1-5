void main() {
  print('=== TASK 1: Multiplication Table ===');
  for (int i = 1; i <= 10; i++) {
    for (int j = 1; j <= 10; j++) {
      print('\(i *\)j = ${i * j}');
    }
    print('---');
  }

  print('\n=== TASK 2: Next Day ===');
  int day = 28;
  int month = 2;
  int year = 2024;

  bool isLeap = (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);

  int daysInMonth = 31;
  if (month == 4 || month == 6 || month == 9 || month == 11) {
    daysInMonth = 30;
  } else if (month == 2) {
    daysInMonth = isLeap ? 29 : 28;
  }

  if (day < 1 || day > daysInMonth || month < 1 || month > 12) {
    print('invalid date');
  } else {
    day++;
    if (day > daysInMonth) {
      day = 1;
      month++;
      if (month > 12) {
        month = 1;
        year++;
      }
    }
    print('Next date: \(day.\)month.$year');
  }

  print('\n=== TASK 3: Vowel Counter ===');
  String text = "flutter mobile development";
  int vowelsCount = 0;
  String vowels = "aeiouAEIOU";

  for (int i = 0; i < text.length; i++) {
    if (vowels.contains(text[i])) {
      vowelsCount++;
    }
  }
  print('String: "$text"');
  print('Vowels count: $vowelsCount');

  print('\n=== TASK 4: Min & Max Finder ===');
  List numbers = [14, 88, 3, 42, 99, 12, 67];

  int min = numbers[0];
  int max = numbers[0];

  for (int num in numbers) {
    if (num < min) {
      min = num;
    }
    if (num > max) {
      max = num;
    }
  }
  print('List: $numbers');
  print('max: \(max, min:\)min');

  print('\n=== TASK 5: Prime Number Checker ===');
  int checkNum = 3;
  bool isPrime = true;

  if (checkNum <= 1) {
    isPrime = false;
  } else {
    for (int i = 2; i < checkNum; i++) {
      if (checkNum % i == 0) {
        isPrime = false;
        break;
      }
    }
  }

  if (isPrime) {
    print('$checkNum -> prime number');
  } else {
    print('$checkNum -> not prime number');
  }
}
